# ──────────────────────────────────────────────────────────────────────────
# data-bp — environment variables
# Copy to `.env` for local dev, `.env.production` for prod.
# Never commit a populated copy. `.env*` is in .gitignore.
# ──────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development                          # production on the server
# Cron scheduler only starts when NODE_ENV=production (see src/app/layout.tsx).

# ── Database ──────────────────────────────────────────────────────────────
# Local dev (docker-compose):
#   postgresql://basket:basket_dev@localhost:5432/basket_analytics
# Prod (same host as Next.js, loopback):
#   postgresql://app_user:STRONG_PW@127.0.0.1:5432/basket_analytics?sslmode=disable
DATABASE_URL=

# Shared Auth DB (basket_auth) — owned and migrated by the portal. This app only
# reads sessions and its `analytics` Acceso here (ADR 0008). Local dev (portal's
# podman container, port 5433):
#   postgresql://basket_auth:PW@localhost:5433/basket_auth
# Prod (loopback): postgresql://basket_auth:PW@127.0.0.1:5433/basket_auth?sslmode=disable
AUTH_DATABASE_URL=

# ── Auth (Session reader) ─────────────────────────────────────────────────
# Must equal the portal's secret, or its session cookie will not verify here.
BETTER_AUTH_SECRET=
# Portal origin: login page, /no-access, /logout and the cookie domain come
# from it. Required in production. Local dev: the portal's dev URL.
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000

# ── Basket.tv private API ─────────────────────────────────────────────────
EXTERNAL_API_BASE=                            # e.g. https://api.basket.tv
EXTERNAL_API_KEY=                             # bearer / header value
BP_TOKEN=                                     # legacy token for some routes
BP_SESSION_COOKIE=                            # Control Panel cookie for /payments (e.g. "_fbp=...; lang=es-ar; _shopify_y=...")
EXTERNAL_USERS_PATH=
EXTERNAL_PAYMENTS_PATH=
EXTERNAL_TEAMS_PATH=
EXTERNAL_TOURNAMENTS_PATH=
EXTERNAL_CONTENT_PATH=
EXTERNAL_SINCE_PARAM=

# ── Sync engine ───────────────────────────────────────────────────────────
SYNC_INTERVAL_HOURS=6                         # cron interval when NODE_ENV=production
SYNC_TOKEN=                                   # `openssl rand -hex 32` — required for POST /api/basket/sync
SYNC_CONTENT_ENABLED=true
SYNC_CONTENT_WINDOW_DAYS=90
SYNC_PAYMENTS_ENABLED=true
SYNC_PAYMENTS_WINDOW=180

# ── Google Sheets (basket/team sheets ingestion) ──────────────────────────
# Service account JSON: paste `client_email` and `private_key`. Escape
# newlines in the key as literal `\n` — code replaces them at boot.
# Generate: GCP console → IAM → Service accounts → Keys → JSON.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Sheet IDs (the long token from the sheet URL):
GOOGLE_SHEETS_ID_GRILLA=
GOOGLE_SHEETS_ID_INCIDENCIAS=
GOOGLE_SHEETS_ID_TOTAL_PARTIDOS=
GOOGLE_SHEETS_TAB_INCIDENCIAS=
GOOGLE_SHEETS_TAB_PARTIDOS_NACIONAL=Ligas Argentinas
GOOGLE_SHEETS_TAB_PARTIDOS_INTL=Ligas Internacionales

# ── Smoke/perf scripts (optional) ─────────────────────────────────────────
# API_BASE=http://localhost:3000
# INTERNAL_API_TOKEN=
# PERF_RUNS=5
# PERF_WARMUP=1

# ── Gateway fees (Stripe + MercadoPago APIs) ──────────────────────────────
# Read-only use: only balance transactions and payment search are called. A
# restricted key is enough and is what should be issued.
#
# Stripe: Dashboard → Developers → API keys → restricted key with
#   "Balance transactions: read" and "Charges: read".
STRIPE_SECRET_KEY=
# Pin the API version so a Stripe upgrade cannot rename a field mid-backfill.
# STRIPE_API_VERSION=2025-08-27.basil
#
# MercadoPago: panel → Tus integraciones → app → Credenciales de producción →
#   Access Token. It must belong to the COLLECTOR account, or fee_details comes
#   back empty and every commission reads as zero.
MP_ACCESS_TOKEN=

# ── Gateway sync inside the normal analytics cron ─────────────────────────
# Fees resume from their own watermark and read only the delta; subscriptions
# refresh in full (a cancellation is an update to an old object, so there is no
# window to read). Set to 'false' to skip both steps entirely.
# SYNC_GATEWAYS_ENABLED=true
# Trailing days re-read each run, so refunds/disputes landing after the charge
# are picked up. Must exceed the gateways' refund/mediation windows.
# SYNC_GATEWAY_FEE_OVERLAP_DAYS=14
# SYNC_GATEWAY_FEE_WINDOW_DAYS=7

# ── Provider Exports that arrive by themselves (SFTP) ─────────────────────
# MercadoPago's report centre pushes its scheduled report to a jailed SFTP
# account on the box; the sync walks the directory and ingests what is new.
# Unset, the step does not exist — the whole feature is off.
#   production: /var/lib/mp-sftp/inbox   (account mpreport, jail /var/lib/mp-sftp)
# Processed files move to <inbox>/done and are deleted after the retention.
# Files refused for their shape stay in the inbox with the reason recorded in
# basket_payment_uploads; the directory itself is the error report.
# MP_SFTP_INBOX=
# MP_SFTP_DONE_RETENTION_DAYS=30

# Google Workspace SMTP for outbound alerts. App password on a dedicated sender
# mailbox (plataforma@), STARTTLS on 587 — the same sender the portal uses.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=plataforma@basquetpass.tv
SMTP_PASS=
MAIL_FROM=plataforma@basquetpass.tv

# scripts/alert-sync-stale.ts — run from the system crontab, not inside the app.
ALERT_EMAIL_TO=
ALERT_STALE_HOURS=48
ALERT_RENOTIFY_HOURS=24
