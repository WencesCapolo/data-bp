# ──────────────────────────────────────────────────────────────────────────
# data-bp — PRODUCTION environment (private server + subdomain).
# This file lives at /etc/data-bp/env on the server (root:data-bp, 0640).
# It is loaded by systemd via `EnvironmentFile=`.
# ──────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Portal (the only Auth server) ─────────────────────────────────────────
# Login page, /no-access, /logout and the cookie domain come from it. Must be
# a subdomain of the SAME registrable domain as this app (cookie scoped to
# that apex). Required in production (src/lib/env.ts).
NEXT_PUBLIC_PORTAL_URL=https://portal.basket-app.com

# ── Database (loopback only; PG bound to 127.0.0.1) ───────────────────────
# Least-privileged app role — NOT the postgres superuser, NOT the owner.
# CREATE ROLE app_user LOGIN PASSWORD '…';
# GRANT CONNECT ON DATABASE basket_analytics TO app_user;
# GRANT USAGE ON SCHEMA public TO app_user;
# GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO app_user;
# ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO app_user;
DATABASE_URL=postgresql://app_user:REPLACE_ME@127.0.0.1:5432/basket_analytics

# ── Shared Auth DB (basket_auth) — owned and migrated by the portal ───────
# This app only reads sessions and its `analytics` Acceso here (ADR 0008).
# SSO REQUIRES BETTER_AUTH_SECRET byte-identical to the portal's.
AUTH_DATABASE_URL=postgresql://basket_auth:REPLACE_ME@127.0.0.1:5433/basket_auth

# ── Secrets (rotate before first deploy + every 90 days) ──────────────────
# Generate fresh values with `scripts/gen-secrets.sh`.
BETTER_AUTH_SECRET=REPLACE_ME_openssl_rand_base64_48
SYNC_TOKEN=REPLACE_ME_openssl_rand_hex_32
INTERNAL_API_TOKEN=REPLACE_ME_openssl_rand_hex_32

# ── Basket.tv private API ─────────────────────────────────────────────────
EXTERNAL_API_BASE=
EXTERNAL_API_KEY=
BP_TOKEN=
BP_SESSION_COOKIE=
EXTERNAL_USERS_PATH=
EXTERNAL_PAYMENTS_PATH=
EXTERNAL_TEAMS_PATH=
EXTERNAL_TOURNAMENTS_PATH=
EXTERNAL_CONTENT_PATH=
EXTERNAL_SINCE_PARAM=

# ── Sync engine ───────────────────────────────────────────────────────────
SYNC_INTERVAL_HOURS=6
SYNC_CONTENT_ENABLED=true
SYNC_CONTENT_WINDOW_DAYS=90
SYNC_PAYMENTS_ENABLED=true
SYNC_PAYMENTS_WINDOW=180

# ── Provider Exports that arrive by themselves (SFTP) ─────────────────────
# MercadoPago's report centre pushes its scheduled report to a jailed SFTP
# account on the box; the sync walks the directory and ingests what is new.
# Unset, the step does not exist — the whole feature is off.
#   production: /var/lib/mp-sftp/inbox   (account mpreport, jail /var/lib/mp-sftp)
# Processed files move to <inbox>/done and are deleted after the retention.
# Files refused for their shape stay in the inbox with the reason recorded in
# basket_payment_uploads; the directory itself is the error report.
# MP_SFTP_INBOX=
# MP_SFTP_DONE_RETENTION_DAYS=30

# ── Google Sheets service account ─────────────────────────────────────────
# Newlines in the private key MUST be escaped as `\n` (single line).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID_GRILLA=
GOOGLE_SHEETS_ID_INCIDENCIAS=
GOOGLE_SHEETS_ID_TOTAL_PARTIDOS=
GOOGLE_SHEETS_TAB_INCIDENCIAS=
GOOGLE_SHEETS_TAB_PARTIDOS_NACIONAL=Ligas Argentinas
GOOGLE_SHEETS_TAB_PARTIDOS_INTL=Ligas Internacionales
